      "rate": "-2%",
      "text": "Vocês escolheram as escadas. Mas elas não estavam como na transmissão."
    },
    {
      "id": "t01",
      "who": "BIA_TEL",
      "at": 14.6,
      "text": "Não desce! Volta pro elevador!"
    },
    {
      "id": "b01",
      "who": "BIA",
      "at": 17.8,
      "text": "Quem tá falando?"
    },
    {
      "id": "n02",
      "who": "NARRADOR",
      "at": 29.2,
      "text": "Na tela, pessoas descem. Na sua frente, não há ninguém."
    },
    {
      "id": "b02",
      "who": "BIA",
      "at": 44.6,
      "rate": "-12%",
      "volume": -25,
      "fx": "whisper",
      "text": "Não… não pode ser."
    },
    {
      "id": "n03",
      "who": "NARRADOR",
      "at": 46.9,
      "pitch": "-9Hz",
      "text": "A saída está bloqueada. A câmera mentiu."
    },
    {
      "id": "d01",
      "who": "DAVI",
      "at": 51.2,
      "text": "Ei! Sou Davi, da manutenção. A saída tá bloqueada, mas existe outro caminho."
    },
    {
      "id": "b03",
      "who": "BIA",
      "at": 58.2,
      "text": "Como eu sei que posso confiar em você?"
    },
    {
      "id": "n04",
      "who": "NARRADOR",
      "at": 62.6,
      "text": "O hacker manda não confiar nele. Mas foi o hacker que falsificou as câmeras."
    },
    {
      "id": "d02",
      "who": "DAVI",
      "at": 68.8,
      "rate": "+6%",
      "text": "Eu tenho a chave do acesso técnico. Vem!"
    },
    {
      "id": "n05",
      "who": "NARRADOR",
      "at": 79.0,
      "rate": "-8%",
      "volume": -10,
      "text": "No celular, você já aparece entrando. Só que ainda está parada… e não está sozinha."
    },
    {
      "id": "n06",
      "who": "NARRADOR",
      "at": 86.8,
      "rate": "+2%",
      "text": "Você segue Davi ou fica na escada? Comenta A ou B!"
