  "lines": [
    {
      "id": "n01",
      "who": "NARRADOR",
      "at": 0.4,
      "text": "Vocês escolheram as escadas. Mas tem um problema: a câmera estava mostrando uma gravação."
    },
    {
      "id": "c01",
      "who": "BIA_CLONE",
      "at": 9.6,
      "text": "Escuta com atenção. Se alguém pedir ajuda na escada… não responde."
    },
    {
      "id": "n02",
      "who": "NARRADOR",
      "at": 16.6,
      "text": "Você decide continuar. Afinal, a saída fica no térreo."
    },
    {
      "id": "m01",
      "who": "HOMEM_LONGE",
      "at": 22.0,
      "text": "Ei! Tem alguém aí? Me ajuda!"
    },
    {
      "id": "n03",
      "who": "NARRADOR",
      "at": 27.2,
      "text": "Você reconhece a roupa. É o homem da gravação."
    },
    {
      "id": "m02",
      "who": "HOMEM",
      "at": 31.8,
      "text": "Por favor! Eu sei como sair daqui!"
    },
    {
      "id": "n04",
      "who": "NARRADOR",
      "at": 39.0,
      "text": "A transmissão é falsa. Mas o homem é real."
    },
    {
      "id": "b01",
      "who": "BIA",
      "at": 46.4,
      "text": "Para! Quem é você?"
    },
    {
      "id": "m03",
      "who": "HOMEM",
      "at": 48.4,
      "text": "Não temos tempo. As câmeras não estão mostrando o que está acontecendo."
    },
    {
      "id": "b02",
      "who": "BIA",
      "at": 53.3,
      "text": "Então o que elas estão escondendo?"
    },
    {
      "id": "m04",
      "who": "HOMEM",
      "at": 55.9,
      "text": "Não se vira."
    },
    {
      "id": "n05",
      "who": "NARRADOR",
      "at": 59.6,
      "text": "Você confia no estranho… ou corre antes de descobrir o que está atrás de você?"
    },
    {
      "id": "n06",
      "who": "NARRADOR",
      "at": 65.6,
      "text": "Você desce com o estranho… ou foge? Comenta A ou B."
    }
  ],
