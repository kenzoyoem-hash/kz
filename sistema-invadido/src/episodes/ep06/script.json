  "title": "A PORTA QUE NÃO DEVERIA ABRIR",
  "fps": 30,
  "voices": {
    "NARRADOR":    {"voice": "pt-BR-AntonioNeural",   "rate": "-1%", "pitch": "-13Hz", "fx": "narrator"},
